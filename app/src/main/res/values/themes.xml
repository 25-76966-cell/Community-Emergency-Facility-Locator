<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CommunityEmergencyFacilityLocator" parent="Theme.AppCompat.Light.NoActionBar">
        <item name="colorPrimary">@color/pink_primary</item>
        <item name="colorPrimaryDark">@color/pink_primary_dark</item>
        <item name="colorAccent">@color/dusty_rose</item>
        <item name="android:colorAccent">@color/dusty_rose</item>
        <item name="android:windowBackground">@color/blush_background</item>
        <item name="android:statusBarColor">@color/blush_background</item>
        <item name="android:navigationBarColor">@color/blush_background</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="android:colorButtonNormal">@color/pink_primary</item>
        <item name="buttonStyle">@style/PastelButton</item>
        <item name="android:buttonStyle">@style/PastelButton</item>
        <item name="editTextStyle">@style/PastelEditText</item>
        <item name="android:editTextStyle">@style/PastelEditText</item>
    </style>

    <style name="PastelButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button_primary</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:elevation">0dp</item>
    </style>

    <style name="PastelEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/soft_ink</item>
        <item name="android:textColorHint">@color/muted_mauve</item>
        <item name="android:textSize">15sp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
    </style>
</resources>