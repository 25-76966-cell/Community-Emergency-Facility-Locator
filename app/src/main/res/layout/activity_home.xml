<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Community Emergency Facility Locator"
        android:textStyle="bold"
        android:textSize="24sp"
        android:gravity="center"/>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Find emergency facilities near you"
        android:layout_marginBottom="20dp"/>

    <Button
        android:id="@+id/hospitalBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Hospital"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/policeBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Police Station"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/fireBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Fire Station"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/reportBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Report Incident"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/trackReportBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Track Report Status"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/emergencyBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Emergency Hotline"
        android:layout_marginBottom="10dp"/>

    <Button
        android:id="@+id/logoutBtn"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:text="Logout"/>

</LinearLayout>