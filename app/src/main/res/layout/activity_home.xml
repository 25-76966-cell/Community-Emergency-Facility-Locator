<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blush_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="22dp"
        android:paddingTop="30dp"
        android:paddingEnd="22dp"
        android:paddingBottom="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@color/blush_soft"
            android:paddingHorizontal="13dp"
            android:paddingVertical="7dp"
            android:text="COMMUNITY CARE"
            android:textColor="@color/pink_primary_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Here when you need us"
            android:textColor="@color/soft_ink"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="20dp"
            android:text="Find nearby help and manage your emergency reports."
            android:textColor="@color/muted_mauve"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:elevation="3dp"
            android:orientation="vertical"
            android:padding="16dp">

            <Button
                android:id="@+id/hospitalBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:text="Find a hospital" />

            <Button
                android:id="@+id/policeBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Find a police station"
                android:textColor="@color/pink_primary_dark" />

            <Button
                android:id="@+id/fireBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Find a fire station"
                android:textColor="@color/pink_primary_dark" />

            <Button
                android:id="@+id/reportBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:text="Report an incident" />

            <Button
                android:id="@+id/trackReportBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/bg_button_secondary"
                android:backgroundTint="@null"
                android:text="Track report status"
                android:textColor="@color/pink_primary_dark" />

            <Button
                android:id="@+id/emergencyBtn"
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:layout_marginBottom="4dp"
                android:text="Emergency hotline" />
        </LinearLayout>

        <Button
            android:id="@+id/logoutBtn"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_button_secondary"
            android:backgroundTint="@null"
            android:text="Log out"
            android:textColor="@color/pink_primary_dark" />
    </LinearLayout>
</ScrollView>