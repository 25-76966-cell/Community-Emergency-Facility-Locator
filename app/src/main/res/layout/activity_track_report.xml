<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/blush_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@color/blush_soft"
        android:paddingHorizontal="13dp"
        android:paddingVertical="7dp"
        android:text="REPORT TRACKING"
        android:textColor="@color/pink_primary_dark"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.1" />

    <TextView
        android:id="@+id/statusText"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:background="@drawable/bg_card"
        android:elevation="3dp"
        android:gravity="center"
        android:padding="28dp"
        android:text="Loading Status..."
        android:textColor="@color/soft_ink"
        android:textSize="24sp"
        android:textStyle="bold" />
</LinearLayout>